{
  "manifest_version": 3,
  "name": "Dịch Truyện",
  "version": "0.3",
  "description": "Dịch trang truyện tranh sang tiếng Việt bằng AI.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Dịch Truyện" }
}
