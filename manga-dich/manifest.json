{
  "manifest_version": 3,
  "name": "Manga Dịch",
  "version": "0.5.2",
  "description": "Dịch manga sang tiếng Việt ngay trên bong bóng thoại - từ bản gốc tiếng Nhật hay bản scan tiếng Anh, Tây Ban Nha, Indonesia… Tự học xưng hô và tên riêng cho từng bộ truyện.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manga Dịch"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "translate-tab": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Dịch trang truyện đang mở"
    }
  }
}
